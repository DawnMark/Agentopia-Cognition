# ── Secrets — never commit ──────────────────────────────────────────────────
config.json
.env
.env.*
gemini_key.json
credentials*.json
*.key
*.pem

# ── Simulation outputs ──────────────────────────────────────────────────────
# Every run directory is named <world>_MMDDHHMM and embeds a copy of config.json,
# which contains API keys. Base worlds under data/ are committed; runs are not.
data/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
data/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/*
data/*.zip
logs/
rft_data/
analysis/
reports/

# ── Private worlds and evaluation data ──────────────────────────────────────
# Locally authored worlds, the persona template used to write them, and every
# report derived from them. Kept out of the public repository on purpose.
data/shanghai_apartment/
data/persona_template_shanghai/
data/CONTAMINATED_*/
docs/character-behavior-analysis-3y.md

